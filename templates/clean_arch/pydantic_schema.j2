from __future__ import annotations
from typing import Optional, List, Dict, Any, Union
from datetime import datetime, date
from uuid import UUID
from pydantic import BaseModel, ConfigDict, Field
from typing_extensions import Annotated

{% for model in models %}
# ==========================================
# {{ model.name }} Schemas
# ==========================================

class {{ model.name }}Base(BaseModel):
{% set non_pk_fields = model.fields | selectattr('is_primary_key', 'equalto', false) | list %}
{% if non_pk_fields %}
{% for field in non_pk_fields %}
    {{ field.name }}: {% if field.nullable %}Optional[{{ field.pydantic_type }}] = None{% else %}{{ field.pydantic_type }}{% endif %}
{% endfor %}
{% else %}
    pass
{% endif %}

class {{ model.name }}Create({{ model.name }}Base):
    pass

class {{ model.name }}Update(BaseModel):
{% if non_pk_fields %}
{% for field in non_pk_fields %}
    {{ field.name }}: Optional[{{ field.pydantic_type }}] = None
{% endfor %}
{% else %}
    pass
{% endif %}

class {{ model.name }}Response({{ model.name }}Base):
    id: int

    model_config = ConfigDict(from_attributes=True)

{% endfor %}

{% for model in models %}
{{ model.name }}Base.model_rebuild()
{{ model.name }}Create.model_rebuild()
{{ model.name }}Update.model_rebuild()
{{ model.name }}Response.model_rebuild()
{% endfor %}

# Polymorphic Mappings
{% for model in models %}
{% if model.is_polymorphic %}
{{ model.name }}Polymorphic = Annotated[
    Union[
{% for key, target in model.polymorphic_mappings.items() %}
        {{ target }}Response{% if not loop.last %},{% endif %}
{% endfor %}
    ],
    Field(discriminator="{{ model.discriminator_field }}")
]
{% endif %}
{% endfor %}
